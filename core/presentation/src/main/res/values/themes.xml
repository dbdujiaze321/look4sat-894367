<resources>
    <color name="accent">#FFE082</color>
    <color name="background">#121212</color>
    <!--
      Launch theme. Not a descendant of Theme.SplashScreen on purpose: the compat library masks the
      icon to a circle below API 31, and the icon here is square artwork. A windowBackground is drawn
      as authored and works on every API level.
    -->
    <style name="Theme.Look4Sat.SplashScreen" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
